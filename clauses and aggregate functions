-- 1. Find the average salary of employees city-wise
-- and display only cities where average salary is less than 45,000.

SELECT city, AVG(salary) AS avg_salary
FROM Employee
GROUP BY city
HAVING AVG(salary) < 45000;


-- 2. Display departments where total number of employees
-- is between 3 and 10.

SELECT department, COUNT(*) AS total_employees
FROM Employee
GROUP BY department
HAVING COUNT(*) BETWEEN 3 AND 10;


-- 3. Find the highest salary among employees whose
-- experience is greater than 5 years department-wise.

SELECT department, MAX(salary) AS highest_salary
FROM Employee
WHERE experience > 5
GROUP BY department;


-- 4. Show total sales amount city-wise for products
-- belonging to the Electronics category.

SELECT city, SUM(sales_amount) AS total_sales
FROM Sales
WHERE category = 'Electronics'
GROUP BY city;


-- 5. Find the minimum salary in each city
-- and order the result in ascending order.

SELECT city, MIN(salary) AS min_salary
FROM Employee
GROUP BY city
ORDER BY min_salary ASC;


-- 6. Display departments where average employee age
-- is greater than 30.

SELECT department, AVG(age) AS avg_age
FROM Employee
GROUP BY department
HAVING AVG(age) > 30;


-- 7. Find the total number of employees working
-- in departments starting with letter 'S'.

SELECT COUNT(*) AS total_employees
FROM Employee
WHERE department LIKE 'S%';


-- 8. Show cities where total salary is less than 500,000.

SELECT city, SUM(salary) AS total_salary
FROM Employee
GROUP BY city
HAVING SUM(salary) < 500000;


-- 9. Find department-wise total salary
-- and average salary together.

SELECT department,
       SUM(salary) AS total_salary,
       AVG(salary) AS avg_salary
FROM Employee
GROUP BY department;


-- 10. Display the city having the highest average salary.

SELECT city, AVG(salary) AS avg_salary
FROM Employee
GROUP BY city
ORDER BY avg_salary DESC
LIMIT 1;


-- 11. Find the number of employees in each department
-- where gender is 'Female'.

SELECT department, COUNT(*) AS female_count
FROM Employee
WHERE gender = 'Female'
GROUP BY department;


-- 12. Show departments where minimum salary
-- is less than 20,000.

SELECT department, MIN(salary) AS min_salary
FROM Employee
GROUP BY department
HAVING MIN(salary) < 20000;


-- 13. Find total salary city-wise excluding
-- employees age less than 25.

SELECT city, SUM(salary) AS total_salary
FROM Employee
WHERE age >= 25
GROUP BY city;


-- 14. Find average salary department-wise,
-- ordered alphabetically.

SELECT department, AVG(salary) AS avg_salary
FROM Employee
GROUP BY department
ORDER BY department ASC;


-- 15. Display cities with more than 4 employees
-- and total salary greater than 300,000.

SELECT city,
       COUNT(*) AS emp_count,
       SUM(salary) AS total_salary
FROM Employee
GROUP BY city
HAVING COUNT(*) > 4
   AND SUM(salary) > 300000;


-- 16. Find maximum salary city-wise for employees
-- with experience greater than 3 years.

SELECT city, MAX(salary) AS max_salary
FROM Employee
WHERE experience > 3
GROUP BY city;


-- 17. Display departments where average salary
-- is between 40,000 and 70,000.

SELECT department, AVG(salary) AS avg_salary
FROM Employee
GROUP BY department
HAVING AVG(salary) BETWEEN 40000 AND 70000;


-- 18. Find the number of employees department-wise
-- where city is Hyderabad or Bangalore.

SELECT department, COUNT(*) AS emp_count
FROM Employee
WHERE city IN ('Hyderabad', 'Bangalore')
GROUP BY department;


-- 19. Find total salary paid to male employees
-- in each department.

SELECT department, SUM(salary) AS total_salary
FROM Employee
WHERE gender = 'Male'
GROUP BY department;


-- 20. Show cities where employee count is less than 5.

SELECT city, COUNT(*) AS emp_count
FROM Employee
GROUP BY city
HAVING COUNT(*) < 5;


-- 21. Find highest and lowest salary in each department.

SELECT department,
       MAX(salary) AS highest_salary,
       MIN(salary) AS lowest_salary
FROM Employee
GROUP BY department;


-- 22. Display departments where total salary
-- is greater than or equal to 250,000.

SELECT department, SUM(salary) AS total_salary
FROM Employee
GROUP BY department
HAVING SUM(salary) >= 250000;


-- 23. Find average experience of employees city-wise.

SELECT city, AVG(experience) AS avg_experience
FROM Employee
GROUP BY city;


-- 24. Find total salary for each city
-- where department is IT.

SELECT city, SUM(salary) AS total_salary
FROM Employee
WHERE department = 'IT'
GROUP BY city;


-- 25. Display departments having exactly 4 employees.

SELECT department, COUNT(*) AS emp_count
FROM Employee
GROUP BY department
HAVING COUNT(*) = 4;


-- 26. Display cities where maximum salary
-- is less than 90,000.

SELECT city, MAX(salary) AS max_salary
FROM Employee
GROUP BY city
HAVING MAX(salary) < 90000;


-- 27. Find total salary and employee count in each city.

SELECT city,
       SUM(salary) AS total_salary,
       COUNT(*) AS emp_count
FROM Employee
GROUP BY city;


-- 28. Display departments where average age is less than 35.

SELECT department, AVG(age) AS avg_age
FROM Employee
GROUP BY department
HAVING AVG(age) < 35;


-- 29. Find city-wise employee count ordered
-- by city name in ascending order.

SELECT city, COUNT(*) AS emp_count
FROM Employee
GROUP BY city
ORDER BY city ASC;


-- 30. Display departments having more than
-- 2 female employees.

SELECT department, COUNT(*) AS female_count
FROM Employee
WHERE gender = 'Female'
GROUP BY department
HAVING COUNT(*) > 2;


-- 31. Find total salary department-wise for employees
-- with experience between 2 and 6 years.

SELECT department, SUM(salary) AS total_salary
FROM Employee
WHERE experience BETWEEN 2 AND 6
GROUP BY department;


-- 32. Find average salary city-wise excluding
-- salaries less than 20,000.

SELECT city, AVG(salary) AS avg_salary
FROM Employee
WHERE salary >= 20000
GROUP BY city;


-- 33. Find the department with the lowest average salary.

SELECT department, AVG(salary) AS avg_salary
FROM Employee
GROUP BY department
ORDER BY avg_salary ASC
LIMIT 1;


-- 34. Find cities where employee count is greater
-- than the average employee count of all cities.

SELECT city, COUNT(*) AS emp_count
FROM Employee
GROUP BY city
HAVING COUNT(*) >
(
    SELECT AVG(cnt)
    FROM
    (
        SELECT COUNT(*) AS cnt
        FROM Employee
        GROUP BY city
    ) AS city_counts
);


-- 35. Find sum of salaries department-wise
-- ordered by total salary descending.

SELECT department, SUM(salary) AS total_salary
FROM Employee
GROUP BY department
ORDER BY total_salary DESC;


-- 36. Display departments where total salary
-- is greater than or equal to 1,000,000.

SELECT department, SUM(salary) AS total_salary
FROM Employee
GROUP BY department
HAVING SUM(salary) >= 1000000;


-- 37. Find average salary for each city where
-- employee count is greater than 5.

SELECT city, AVG(salary) AS avg_salary
FROM Employee
GROUP BY city
HAVING COUNT(*) > 5;


-- 38. Find highest salary among female employees
-- in each department.

SELECT department, MAX(salary) AS highest_salary
FROM Employee
WHERE gender = 'Female'
GROUP BY department;


-- 39. Display departments where the difference between
-- maximum and minimum salary is greater than 50,000.

SELECT department
FROM Employee
GROUP BY department
HAVING MAX(salary) - MIN(salary) > 50000;


-- 40. Find city-wise total salary only for cities
-- ending with 'pur'.

SELECT city, SUM(salary) AS total_salary
FROM Employee
WHERE city LIKE '%pur'
GROUP BY city;
