```sql
-- 1. Average salary of employees city-wise,
-- only cities where average salary is less than 45,000

SELECT city, AVG(salary) AS average_salary
FROM Employee
GROUP BY city
HAVING AVG(salary) < 45000;


-- 2. Departments where total number of employees
-- is between 3 and 10

SELECT department, COUNT(*) AS total_employees
FROM Employee
GROUP BY department
HAVING COUNT(*) BETWEEN 3 AND 10;


-- 3. Highest salary among employees whose
-- experience is greater than 5 years department-wise

SELECT department, MAX(salary) AS highest_salary
FROM Employee
WHERE experience > 5
GROUP BY department;


-- 4. Total sales amount city-wise for products
-- belonging to Electronics category

SELECT city, SUM(sales_amount) AS total_sales
FROM Sales
WHERE category = 'Electronics'
GROUP BY city;


-- 5. Minimum salary in each city,
-- ordered in ascending order

SELECT city, MIN(salary) AS minimum_salary
FROM Employee
GROUP BY city
ORDER BY minimum_salary ASC;


-- 6. Departments where average employee age
-- is greater than 30

SELECT department, AVG(age) AS average_age
FROM Employee
GROUP BY department
HAVING AVG(age) > 30;


-- 7. Total number of employees working in departments
-- starting with letter 'S'

SELECT COUNT(*) AS total_employees
FROM Employee
WHERE department LIKE 'S%';


-- 8. Cities where total salary is less than 500,000

SELECT city, SUM(salary) AS total_salary
FROM Employee
GROUP BY city
HAVING SUM(salary) < 500000;


-- 9. Department-wise total salary and average salary

SELECT department,
       SUM(salary) AS total_salary,
       AVG(salary) AS average_salary
FROM Employee
GROUP BY department;


-- 10. City having the highest average salary

SELECT city, AVG(salary) AS average_salary
FROM Employee
GROUP BY city
ORDER BY average_salary DESC
LIMIT 1;


-- 11. Number of employees in each department
-- where gender is Female

SELECT department, COUNT(*) AS female_employees
FROM Employee
WHERE gender = 'Female'
GROUP BY department;


-- 12. Departments where minimum salary
-- is less than 20,000

SELECT department, MIN(salary) AS minimum_salary
FROM Employee
GROUP BY department
HAVING MIN(salary) < 20000;


-- 13. Total salary city-wise excluding employees
-- whose age is less than 25

SELECT city, SUM(salary) AS total_salary
FROM Employee
WHERE age >= 25
GROUP BY city;


-- 14. Average salary department-wise,
-- ordered alphabetically

SELECT department, AVG(salary) AS average_salary
FROM Employee
GROUP BY department
ORDER BY department ASC;


-- 15. Cities having more than 4 employees
-- and total salary greater than 300,000

SELECT city,
       COUNT(*) AS employee_count,
       SUM(salary) AS total_salary
FROM Employee
GROUP BY city
HAVING COUNT(*) > 4
AND SUM(salary) > 300000;


-- 16. Maximum salary city-wise for employees
-- with experience greater than 3 years

SELECT city, MAX(salary) AS maximum_salary
FROM Employee
WHERE experience > 3
GROUP BY city;


-- 17. Departments where average salary
-- is between 40,000 and 70,000

SELECT department, AVG(salary) AS average_salary
FROM Employee
GROUP BY department
HAVING AVG(salary) BETWEEN 40000 AND 70000;


-- 18. Count of employees department-wise
-- where city is Hyderabad or Bangalore

SELECT department, COUNT(*) AS employee_count
FROM Employee
WHERE city IN ('Hyderabad', 'Bangalore')
GROUP BY department;


-- 19. Total salary paid to male employees
-- in each department

SELECT department, SUM(salary) AS total_salary
FROM Employee
WHERE gender = 'Male'
GROUP BY department;


-- 20. Cities where employee count is less than 5

SELECT city, COUNT(*) AS employee_count
FROM Employee
GROUP BY city
HAVING COUNT(*) < 5;


-- 21. Highest and lowest salary in each department

SELECT department,
       MAX(salary) AS highest_salary,
       MIN(salary) AS lowest_salary
FROM Employee
GROUP BY department;


-- 22. Departments where total salary
-- is greater than or equal to 250,000

SELECT department, SUM(salary) AS total_salary
FROM Employee
GROUP BY department
HAVING SUM(salary) >= 250000;


-- 23. Average experience of employees city-wise

SELECT city, AVG(experience) AS average_experience
FROM Employee
GROUP BY city;


-- 24. Total salary for each city
-- where department is IT

SELECT city, SUM(salary) AS total_salary
FROM Employee
WHERE department = 'IT'
GROUP BY city;


-- 25. Departments having exactly 4 employees

SELECT department, COUNT(*) AS employee_count
FROM Employee
GROUP BY department
HAVING COUNT(*) = 4;


-- 26. Cities where maximum salary
-- is less than 90,000

SELECT city, MAX(salary) AS maximum_salary
FROM Employee
GROUP BY city
HAVING MAX(salary) < 90000;


-- 27. Total salary and employee count in each city

SELECT city,
       SUM(salary) AS total_salary,
       COUNT(*) AS employee_count
FROM Employee
GROUP BY city;


-- 28. Departments where average age is less than 35

SELECT department, AVG(age) AS average_age
FROM Employee
GROUP BY department
HAVING AVG(age) < 35;


-- 29. City-wise employee count ordered
-- by city name ascending

SELECT city, COUNT(*) AS employee_count
FROM Employee
GROUP BY city
ORDER BY city ASC;


-- 30. Departments having more than 2 female employees

SELECT department, COUNT(*) AS female_count
FROM Employee
WHERE gender = 'Female'
GROUP BY department
HAVING COUNT(*) > 2;


-- 31. Total salary department-wise for employees
-- with experience between 2 and 6 years

SELECT department, SUM(salary) AS total_salary
FROM Employee
WHERE experience BETWEEN 2 AND 6
GROUP BY department;


-- 32. Average salary city-wise excluding
-- salaries less than 20,000

SELECT city, AVG(salary) AS average_salary
FROM Employee
WHERE salary >= 20000
GROUP BY city;


-- 33. Department with the lowest average salary

SELECT department, AVG(salary) AS average_salary
FROM Employee
GROUP BY department
ORDER BY average_salary ASC
LIMIT 1;


-- 34. Cities where employee count is greater
-- than the average employee count of all cities

SELECT city, COUNT(*) AS employee_count
FROM Employee
GROUP BY city
HAVING COUNT(*) >
(
    SELECT AVG(employee_count)
    FROM
    (
        SELECT city, COUNT(*) AS employee_count
        FROM Employee
        GROUP BY city
    ) AS city_counts
);


-- 35. Sum of salaries department-wise,
-- ordered by total salary descending

SELECT department, SUM(salary) AS total_salary
FROM Employee
GROUP BY department
ORDER BY total_salary DESC;


-- 36. Departments where total salary
-- is greater than or equal to 1,000,000

SELECT department, SUM(salary) AS total_salary
FROM Employee
GROUP BY department
HAVING SUM(salary) >= 1000000;


-- 37. Average salary for each city where
-- employee count is greater than 5

SELECT city, AVG(salary) AS average_salary
FROM Employee
GROUP BY city
HAVING COUNT(*) > 5;


-- 38. Highest salary among female employees
-- in each department

SELECT department, MAX(salary) AS highest_salary
FROM Employee
WHERE gender = 'Female'
GROUP BY department;


-- 39. Departments where the difference between
-- maximum and minimum salary is greater than 50,000

SELECT department
FROM Employee
GROUP BY department
HAVING MAX(salary) - MIN(salary) > 50000;


-- 40. City-wise total salary only for cities
-- ending with 'pur'

SELECT city, SUM(salary) AS total_salary
FROM Employee
WHERE city LIKE '%pur'
GROUP BY city;
```
