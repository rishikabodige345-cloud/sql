```sql
-- 1. Average salary city-wise, only below 45,000
SELECT city, AVG(salary) AS average_salary
FROM Employee
GROUP BY city
HAVING AVG(salary) < 45000;


-- 2. Departments where employee count is between 3 and 10
SELECT department, COUNT(*) AS employee_count
FROM Employee
GROUP BY department
HAVING COUNT(*) BETWEEN 3 AND 10;


-- 3. Highest salary department-wise for employees with experience > 5
SELECT department, MAX(salary) AS highest_salary
FROM Employee
WHERE experience > 5
GROUP BY department;


-- 4. Total sales amount city-wise for Electronics
-- IMPORTANT: Your document does not provide a sales table/sales_amount column.
-- If sales_amount is a column in the same table, use:
SELECT city, SUM(sales_amount) AS total_sales
FROM Employee
WHERE category = 'Electronics'
GROUP BY city;


-- 5. Minimum salary in each city, ascending
SELECT city, MIN(salary) AS minimum_salary
FROM Employee
GROUP BY city
ORDER BY minimum_salary ASC;


-- 6. Departments where average age > 30
SELECT department, AVG(age) AS average_age
FROM Employee
GROUP BY department
HAVING AVG(age) > 30;


-- 7. Total number of employees in departments starting with S
SELECT COUNT(*) AS total_employees
FROM Employee
WHERE department LIKE 'S%';


-- 8. Cities where total salary < 500,000
SELECT city, SUM(salary) AS total_salary
FROM Employee
GROUP BY city
HAVING SUM(salary) < 500000;


-- 9. Department-wise total salary and average salary
SELECT department,
       SUM(salary) AS total_salary,
       AVG(salary) AS average_salary
FROM Employee
GROUP BY department;


-- 10. City having the highest average salary
SELECT city, AVG(salary) AS average_salary
FROM Employee
GROUP BY city
ORDER BY average_salary DESC
LIMIT 1;


-- 11. Number of female employees in each department
SELECT department, COUNT(*) AS female_count
FROM Employee
