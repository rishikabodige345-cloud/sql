-- 1. Average salary city-wise, only cities < 45,000
SELECT city, AVG(salary)
FROM Employee
GROUP BY city
HAVING AVG(salary) < 45000;

-- 2. Departments with total employees between 3 and 10
SELECT department, COUNT(*)
FROM Employee
GROUP BY department
HAVING COUNT(*) BETWEEN 3 AND 10;

-- 3. Highest salary among employees with >5 years experience, department-wise
SELECT department, MAX(salary)
FROM Employee
WHERE experience > 5
GROUP BY department;

-- 4. Total sales amount city-wise for Electronics category
SELECT city, SUM(sales_amount)
FROM Sales
WHERE category = 'Electronics'
GROUP BY city;

-- 5. Minimum salary in each city, ordered ascending
SELECT city, MIN(salary)
FROM Employee
GROUP BY city
ORDER BY MIN(salary);

-- 6. Departments where average employee age > 30
SELECT department, AVG(age)
FROM Employee
GROUP BY department
HAVING AVG(age) > 30;

-- 7. Total employees in departments starting with 'S'
SELECT department, COUNT(*)
FROM Employee
WHERE department LIKE 'S%'
GROUP BY department;

-- 8. Cities where total salary < 500,000
SELECT city, SUM(salary)
FROM Employee
GROUP BY city
HAVING SUM(salary) < 500000;

-- 9. Department-wise total salary and average salary together
SELECT department, SUM(salary), AVG(salary)
FROM Employee
GROUP BY department;

-- 10. City having the highest average salary
SELECT city, AVG(salary)
FROM Employee
GROUP BY city
ORDER BY AVG(salary) DESC
LIMIT 1;

-- 11. Number of female employees in each department
SELECT department, COUNT(*)
FROM Employee
WHERE gender = 'Female'
GROUP BY department;

-- 12. Departments where minimum salary < 20,000
SELECT department, MIN(salary)
FROM Employee
GROUP BY department
HAVING MIN(salary) < 20000;

-- 13. Total salary city-wise excluding employees age < 25
SELECT city, SUM(salary)
FROM Employee
WHERE age >= 25
GROUP BY city;

-- 14. Average salary department-wise, ordered alphabetically
SELECT department, AVG(salary)
FROM Employee
GROUP BY department
ORDER BY department;

-- 15. Cities with >4 employees AND total salary > 300,000
SELECT city, COUNT(*), SUM(salary)
FROM Employee
GROUP BY city
HAVING COUNT(*) > 4 AND SUM(salary) > 300000;

-- 16. Maximum salary city-wise for employees with experience > 3 years
SELECT city, MAX(salary)
FROM Employee
WHERE experience > 3
GROUP BY city;

-- 17. Departments where average salary is between 40,000 and 70,000
SELECT department, AVG(salary)
FROM Employee
GROUP BY department
HAVING AVG(salary) BETWEEN 40000 AND 70000;

-- 18. Count of employees department-wise where city is Hyderabad or Bangalore
SELECT department, COUNT(*)
FROM Employee
WHERE city IN ('Hyderabad','Bangalore')
GROUP BY department;

-- 19. Total salary paid to male employees in each department
SELECT department, SUM(salary)
FROM Employee
WHERE gender = 'Male'
GROUP BY department;

-- 20. Cities where employee count < 5
SELECT city, COUNT(*)
FROM Employee
GROUP BY city
HAVING COUNT(*) < 5;

-- 21. Highest and lowest salary in each department
SELECT department, MAX(salary), MIN(salary)
FROM Employee
GROUP BY department;

-- 22. Departments where total salary >= 250,000
SELECT department, SUM(salary)
FROM Employee
GROUP BY department
HAVING SUM(salary) >= 250000;

-- 23. Average experience of employees city-wise
SELECT city, AVG(experience)
FROM Employee
GROUP BY city;

-- 24. Total salary for each city where department is IT
SELECT city, SUM(salary)
FROM Employee
WHERE department = 'IT'
GROUP BY city;

-- 25. Departments having exactly 4 employees
SELECT department, COUNT(*)
FROM Employee
GROUP BY department
HAVING COUNT(*) = 4;

-- 26. Cities where maximum salary < 90,000
SELECT city, MAX(salary)
FROM Employee
GROUP BY city
HAVING MAX(salary) < 90000;

-- 27. Total salary and employee count in each city
SELECT city, SUM(salary), COUNT(*)
FROM Employee
GROUP BY city;

-- 28. Departments where average age < 35
SELECT department, AVG(age)
FROM Employee
GROUP BY department
HAVING AVG(age) < 35;

-- 29. City-wise employee count ordered by city name ascending
SELECT city, COUNT(*)
FROM Employee
GROUP BY city
ORDER BY city;

-- 30. Departments having more than 2 female employees
SELECT department, COUNT(*)
FROM Employee
WHERE gender = 'Female'
GROUP BY department
HAVING COUNT(*) > 2;

-- 31. Total salary department-wise for employees with experience between 2 and 6 years
SELECT department, SUM(salary)
FROM Employee
WHERE experience BETWEEN 2 AND 6
GROUP BY department;

-- 32. Average salary city-wise excluding salaries < 20,000
SELECT city, AVG(salary)
FROM Employee
WHERE salary >= 20000
GROUP BY city;

-- 33. Department with the lowest average salary
SELECT department, AVG(salary)
FROM Employee
GROUP BY department
ORDER BY AVG(salary)
LIMIT 1;

-- 34. Cities where employee count > average employee count of all cities
SELECT city, COUNT(*)
FROM Employee
GROUP BY city
HAVING COUNT(*) >
(SELECT AVG(cnt)
 FROM (SELECT COUNT(*) AS cnt
       FROM Employee
       GROUP BY city) t);

-- 35. Sum of salaries department-wise ordered by total salary descending
SELECT department, SUM(salary)
FROM Employee
GROUP BY department
ORDER BY SUM(salary) DESC;

-- 36. Departments where total salary >= 1,000,000
SELECT department, SUM(salary)
FROM Employee
GROUP BY department
HAVING SUM(salary) >= 1000000;

-- 37. Average salary for each city where employee count > 5
SELECT city, AVG(salary)
FROM Employee
GROUP BY city
HAVING COUNT(*) > 5;

-- 38. Highest salary among female employees in each department
SELECT department, MAX(salary)
FROM Employee
WHERE gender = 'Female'
GROUP BY department;

-- 39. Departments where (MAX - MIN salary) > 50,000
SELECT department
FROM Employee
GROUP BY department
HAVING MAX(salary) - MIN(salary) > 50000;

-- 40. City-wise total salary, only cities ending with 'pur'
SELECT city, SUM(salary)
FROM Employee
WHERE city LIKE '%pur'
GROUP BY city;
