# Program to print all perfect square numbers between 1 and 100

for num in range(1, 101):

    square = int(num ** 0.5)

    if square * square == num:

        print(num)

# Program to print all Armstrong numbers between 1 and 100

for num in range(1, 101):

    temp = num

    digits = len(str(num))

    total = 0

    while temp > 0:

        digit = temp % 10

        total = total + digit ** digits

        temp = temp // 10

    if total == num:

        print(num)
