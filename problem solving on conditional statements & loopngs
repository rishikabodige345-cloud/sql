print("Perfect square numbers between 1 and 100:")

for i in range(1, 101):
    for j in range(1, i + 1):
        if j * j == i:
            print(i, end=" ")

print("\n\nArmstrong numbers between 1 and 100:")

for i in range(1, 101):
    temp = i
    sum = 0

    while temp > 0:
        digit = temp % 10
        sum = sum + digit ** 3
        temp = temp // 10

    if sum == i:
        print(i, end=" ")
