print("Perfect square numbers between 1 and 100:")

for i in range(1, 101):
    if int(i * 0.5) * 2 == i:
        print(i, end=" ")

print("\nArmstrong numbers between 1 and 100:")

for i in range(1, 101):
    temp = i
    total = 0

    while temp > 0:
        digit = temp % 10
        total = total + digit ** 3
        temp = temp // 10

    if total == i:
        print(i, end=" ")

  
